# Server only. Copy to .env.local; never commit real secrets.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=quanlybaocao
# Migrating accounts: use EXACT value of SL_AUTH_PEPPER in old Apps Script properties.
# Brand-new database only: generate with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SL_AUTH_PEPPER=
# Only needed to initialize a NEW app without importing Sheets. Remove after creation.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
